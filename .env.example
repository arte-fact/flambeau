# ROCm stack — pin to the version candle's memory has validated on gfx906.
# ROCm 7.2.1 has a slower RCCL on gfx906 (candle feedback notes) and its
# rocprof can't interpose the 7.2.1 runtime cleanly. 7.1.1 is the matched
# hipcc + libamdhip64 + librccl + rocprofv3 combo that actually works.
#
# Load before `cargo build` / `cargo run` / `flambeau sweep`:
#   set -a; source .env; set +a
# or via direnv.

ROCM_PATH=/opt/rocm-7.1.1

# Where our build.rs rpath's against (must stay on LD_LIBRARY_PATH for test
# binaries that bypass rpath, and for rocprofv3's preload path).
LD_LIBRARY_PATH=/opt/rocm-7.1.1/lib:/opt/rocm-7.1.1/core-7.13/lib

# Matched rocprofv3 (V1.3 runtime PMC wrapper invokes this).
ROCPROFV3=/opt/rocm-7.1.1/core-7.13/bin/rocprofv3

# hipcc for manual/debug invocations.
HIPCC=/opt/rocm-7.1.1/bin/hipcc

# Force single-GPU test paths to use device 0 explicitly rather than
# defaulting to the kernel-visible list (avoids surprises on 4× rigs).
HIP_VISIBLE_DEVICES=0,1,2,3

# --- Model assets (optional; only for real-GGUF integration tests) ---------
#
# Tests that load a real Qwen3 MoE file skip when this is unset. Any GGUF
# whose `general.architecture` is qwen3moe / qwen35moe / qwen36moe works.
# FLAMBEAU_QWEN3_GGUF=/path/to/Qwen3-Coder-30B-A3B-Instruct-UD-Q4_K_XL.gguf
